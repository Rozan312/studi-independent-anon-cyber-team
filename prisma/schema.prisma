generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  STUDENT
  INSTRUCTOR
  ADMIN
}

enum AnswerType {
  TEXT
  MULTIPLE_CHOICE
  CHECKBOX
}

enum ContentFormat {
  MARKDOWN
  HTML
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum ClassMemberRole {
  STUDENT
  ASSISTANT
}

enum AnnouncementAudience {
  ALL
  STUDENT
  INSTRUCTOR
  ADMIN
}

enum LeaderboardSourceType {
  ROOM_COMPLETION
  QUIZ_COMPLETION
  TASK_COMPLETION
  MANUAL_ADJUSTMENT
}

enum LabStatus {
  READY
  STARTING
  RUNNING
  STOPPED
  EXPIRED
  ERROR
}

enum VpnStatus {
  DISCONNECTED
  CONNECTING
  CONNECTED
}

enum MachineStatus {
  OFFLINE
  STARTING
  ONLINE
  STOPPING
}

model Profile {
  id                String               @id @db.Uuid
  email             String               @unique
  fullName          String
  username          String               @unique
  role              Role                 @default(STUDENT)
  avatarUrl         String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  roomProgress      UserRoomProgress[]
  taskSubmissions   UserTaskSubmission[]
  quizAttempts      UserQuizAttempt[]
  instructedClasses Class[]              @relation("InstructorClasses")
  classMemberships  ClassMember[]
  announcements     Announcement[]       @relation("AnnouncementAuthor")
  leaderboardPoints LeaderboardPoint[]
  labSessions       LabSession[]
  authoredRooms     Room[]               @relation("RoomAuthor")
  authoredPaths     LearningPath[]       @relation("LearningPathAuthor")
  mediaAssets       MediaAsset[]

  @@index([role])
}

model LearningPath {
  id             String   @id @default(uuid()) @db.Uuid
  title          String
  slug           String   @unique
  description    String
  category       String
  difficulty     String
  estimatedHours Int
  coverImageUrl  String?
  logoUrl        String?
  createdById    String?  @db.Uuid
  isPublished    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  rooms          Room[]
  createdBy      Profile? @relation("LearningPathAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdById])
}

model Room {
  id               String             @id @default(uuid()) @db.Uuid
  learningPathId   String             @db.Uuid
  title            String
  slug             String             @unique
  description      String
  category         String
  difficulty       String
  estimatedMinutes Int
  points           Int
  orderIndex       Int
  // Cadangan materi lama (sebelum ada bab). Tidak dibaca/ditulis lagi; materi kini di RoomChapter.
  content          String             @default("")
  contentFormat    ContentFormat      @default(MARKDOWN)
  coverImageUrl    String?
  logoUrl          String?
  createdById      String?            @db.Uuid
  isPublished      Boolean            @default(false)
  availableFrom    DateTime?
  availableUntil   DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  learningPath     LearningPath       @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
  chapters         RoomChapter[]
  tasks            RoomTask[]
  quiz             Quiz?
  quizAttempts     UserQuizAttempt[]
  userProgress     UserRoomProgress[]
  labSessions      LabSession[]
  createdBy        Profile?           @relation("RoomAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([learningPathId, orderIndex])
  @@index([createdById])
  @@index([isPublished])
}

/// Bab materi room. Urutan bab hanya navigasi baca; tidak memengaruhi syarat selesai room.
model RoomChapter {
  id            String        @id @default(uuid()) @db.Uuid
  roomId        String        @db.Uuid
  title         String
  content       String        @default("")
  contentFormat ContentFormat @default(HTML)
  orderIndex    Int
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  room          Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  tasks         RoomTask[]

  @@index([roomId, orderIndex])
}

/// Task boleh ditempel ke satu bab room yang sama. chapterId null (atau babnya dihapus) berarti tampil di bab terakhir.
/// orderIndex tetap urutan 1..n per room; urutan di dalam bab mengikuti orderIndex itu.
model RoomTask {
  id              String               @id @default(uuid()) @db.Uuid
  roomId          String               @db.Uuid
  chapterId       String?              @db.Uuid
  title           String
  description     String
  orderIndex      Int
  answerType      AnswerType
  expectedAnswer  String?
  acceptedAnswers String[]             @default([])
  hint            String?
  points          Int
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  room            Room                 @relation(fields: [roomId], references: [id], onDelete: Cascade)
  chapter         RoomChapter?         @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  userSubmissions UserTaskSubmission[]

  @@index([roomId, orderIndex])
  @@index([chapterId, orderIndex])
}

model Quiz {
  id           String            @id @default(uuid()) @db.Uuid
  roomId       String            @unique @db.Uuid
  title        String
  description  String
  passingScore Int
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  room         Room              @relation(fields: [roomId], references: [id], onDelete: Cascade)
  questions    QuizQuestion[]
  attempts     UserQuizAttempt[]
}

model QuizQuestion {
  id          String       @id @default(uuid()) @db.Uuid
  quizId      String       @db.Uuid
  question    String
  explanation String
  orderIndex  Int
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  quiz        Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options     QuizOption[]

  @@index([quizId, orderIndex])
}

model QuizOption {
  id         String       @id @default(uuid()) @db.Uuid
  questionId String       @db.Uuid
  label      String
  isCorrect  Boolean      @default(false)
  orderIndex Int          @default(0)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId, orderIndex])
}

model UserRoomProgress {
  id                 String         @id @default(uuid()) @db.Uuid
  userId             String         @db.Uuid
  roomId             String         @db.Uuid
  status             ProgressStatus @default(NOT_STARTED)
  progressPercentage Int            @default(0)
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  user               Profile        @relation(fields: [userId], references: [id], onDelete: Cascade)
  room               Room           @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([userId, roomId])
  @@index([roomId])
}

model UserTaskSubmission {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  taskId      String   @db.Uuid
  answer      String
  isCorrect   Boolean
  submittedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  user        Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  task        RoomTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([userId, taskId])
}

/// Riwayat attempt tetap ada walau quiz-nya dihapus instruktur: quizId menjadi null, sedangkan roomId dan
/// quizTitle menyimpan room dan judul quiz untuk halaman riwayat member.
model UserQuizAttempt {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  quizId      String?   @db.Uuid
  roomId      String?   @db.Uuid
  quizTitle   String    @default("")
  score       Int
  passed      Boolean
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  user        Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz        Quiz?     @relation(fields: [quizId], references: [id], onDelete: SetNull)
  room        Room?     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([userId, quizId])
  @@index([userId, roomId])
}

model Class {
  id           String        @id @default(uuid()) @db.Uuid
  name         String
  description  String
  instructorId String        @db.Uuid
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  instructor   Profile       @relation("InstructorClasses", fields: [instructorId], references: [id], onDelete: Cascade)
  members      ClassMember[]

  @@index([instructorId])
}

model ClassMember {
  id       String          @id @default(uuid()) @db.Uuid
  classId  String          @db.Uuid
  userId   String          @db.Uuid
  joinedAt DateTime        @default(now())
  role     ClassMemberRole @default(STUDENT)
  class    Class           @relation(fields: [classId], references: [id], onDelete: Cascade)
  user     Profile         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([classId, userId])
  @@index([userId])
}

model Announcement {
  id          String               @id @default(uuid()) @db.Uuid
  title       String
  content     String
  audience    AnnouncementAudience @default(ALL)
  createdById String               @db.Uuid
  isPublished Boolean              @default(false)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  createdBy   Profile              @relation("AnnouncementAuthor", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([audience, isPublished])
}

model LeaderboardPoint {
  id         String                @id @default(uuid()) @db.Uuid
  userId     String                @db.Uuid
  points     Int
  sourceType LeaderboardSourceType
  sourceId   String?
  createdAt  DateTime              @default(now())
  user       Profile               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sourceType, sourceId])
}

model LabSession {
  id            String        @id @default(uuid()) @db.Uuid
  userId        String        @db.Uuid
  roomId        String        @db.Uuid
  status        LabStatus     @default(READY)
  targetIp      String?
  vpnStatus     VpnStatus     @default(DISCONNECTED)
  machineStatus MachineStatus @default(OFFLINE)
  startedAt     DateTime?
  expiresAt     DateTime?
  endedAt       DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  user          Profile       @relation(fields: [userId], references: [id], onDelete: Cascade)
  room          Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([userId, roomId])
  @@index([status])
}

model MediaAsset {
  id         String   @id @default(uuid()) @db.Uuid
  uploaderId String?  @db.Uuid
  fileName   String
  mimeType   String
  sizeBytes  Int
  storageKey String   @unique
  createdAt  DateTime @default(now())
  uploader   Profile? @relation(fields: [uploaderId], references: [id], onDelete: SetNull)

  @@index([uploaderId, createdAt])
}
